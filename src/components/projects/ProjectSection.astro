---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

import type { IconsType } from 'astro-pure/types'
import { Icon } from 'astro-pure/user'

const projectIconSet = {
  github: 'github-circle',
  site: 'earth',
  doc: 'document',
  release: 'package'
} as const satisfies Record<string, IconsType>

interface Project {
  image?: string
  name: string
  description: string
  links: {
    type: keyof typeof projectIconSet
    href: string
  }[]
}

interface Props {
  class?: string
  projects: Project[]
}

const { class: className, projects, ...props } = Astro.props
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/projects/*.{jpeg,jpg,png,gif,avif,webp}'
)
---

<div class={className} {...props}>
  <div class='grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-5'>
    {
      projects.map((project) => {
        const imagePath = project.image ? `/src/assets/projects/${project.image}` : null
        if (imagePath && !images[imagePath]) {
          throw new Error(
            `"${imagePath}" does not exist in glob: "src/assets/projects/*.{jpeg,jpg,png,gif,avif,webp}"`
          )
        }

        const mainLink = project.links[0]?.href

        return (
          <article
            class='project-showcase group relative isolate flex min-h-56 flex-col overflow-hidden rounded-2xl border border-border/70 bg-muted p-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-lg hover:shadow-primary/5 sm:p-6'
            data-spotlight
          >
            {imagePath && (
              <Image
                class='pointer-events-none absolute inset-0 -z-10 h-full w-full object-cover opacity-20 transition-opacity duration-300 group-hover:opacity-30'
                src={images[imagePath]()}
                alt=''
                loading='lazy'
              />
            )}
            <div
              aria-hidden='true'
              class='pointer-events-none absolute inset-0 -z-10 bg-gradient-to-r from-background/90 via-background/75 to-background/45'
            />
            <div aria-hidden='true' class='project-showcase-light pointer-events-none absolute inset-0 -z-10' />

            <div class='flex flex-1 flex-col'>
              <div class='mb-3 flex items-start justify-between gap-3'>
                <div class='min-w-0'>
                  <p class='mb-1 text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-primary'>
                    Project
                  </p>
                  <h3 class='text-xl font-semibold leading-tight'>
                    {mainLink ? (
                      <a
                        class='rounded-sm text-foreground no-underline outline-none transition-colors hover:text-primary focus-visible:ring-2 focus-visible:ring-primary'
                        href={mainLink}
                        target='_blank'
                        rel='noreferrer'
                      >
                        {project.name}
                      </a>
                    ) : (
                      project.name
                    )}
                  </h3>
                </div>
                {mainLink && (
                  <span class='rounded-full border border-border/80 bg-background/70 p-2 text-muted-foreground transition-colors group-hover:text-primary'>
                    <svg aria-hidden='true' viewBox='0 0 24 24' class='size-4' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
                      <path d='M5 12h14' /><path d='m12 5 7 7-7 7' />
                    </svg>
                  </span>
                )}
              </div>

              <p class='max-w-prose text-sm leading-relaxed text-muted-foreground'>
                {project.description}
              </p>

              {project.links.length > 0 && (
                <nav class='mt-auto flex flex-wrap gap-2 pt-5' aria-label={`${project.name} links`}>
                  {project.links.map((link) => (
                    <a
                      href={link.href}
                      class='inline-flex items-center gap-2 rounded-full border border-border/80 bg-background/75 px-3 py-1.5 text-xs font-medium text-muted-foreground no-underline transition-colors hover:border-primary/40 hover:text-primary'
                      aria-label={`${project.name}: ${link.type}`}
                      title={link.type}
                      target='_blank'
                      rel='noreferrer'
                    >
                      <Icon class='size-4' name={projectIconSet[link.type]} />
                      <span>{link.type}</span>
                    </a>
                  ))}
                </nav>
              )}
            </div>
          </article>
        )
      })
    }
  </div>
</div>

<style>
  .project-showcase-light {
    opacity: 0;
    background: radial-gradient(
      260px circle at var(--spotlight-x, 50%) var(--spotlight-y, 50%),
      hsl(var(--primary) / 0.19),
      transparent 72%
    );
    transition: opacity 250ms ease;
  }

  .project-showcase:hover .project-showcase-light,
  .project-showcase:focus-within .project-showcase-light {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-showcase,
    .project-showcase-light {
      transition: none;
    }
  }
</style>
