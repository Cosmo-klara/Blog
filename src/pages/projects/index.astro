---
// import { Image } from 'astro:assets'

import { Icon } from 'astro-pure/user'
import PageLayout from '@/layouts/CommonPage.astro'
import Sponsorship from '@/components/projects/Sponsorship.astro'
import wechat from '@/assets/wechat-qrcode.png'

const headings = [
  { depth: 2, slug: 'sponsorship', text: 'Sponsorship' }
]
---

<PageLayout title='Projects' {headings}>
  <div class='not-prose'>
    <a
      class='project-profile group relative isolate flex min-h-56 w-full flex-col justify-end overflow-hidden rounded-2xl border border-border/70 bg-muted p-5 text-foreground no-underline transition-all duration-300 hover:-translate-y-0.5 hover:border-primary/40 hover:shadow-lg hover:shadow-primary/5 md:max-w-2xl sm:p-6'
      href='https://github.com/Cosmo-klara'
      target='_blank'
      rel='noreferrer'
      data-spotlight
    >
      <img
        class='pointer-events-none absolute inset-0 z-0 h-full w-full object-cover opacity-40'
        src='/images/banner.webp'
        alt=''
      />
      <div aria-hidden='true' class='absolute inset-0 z-0 bg-gradient-to-t from-background via-background/65 to-background/10' />
      <div aria-hidden='true' class='project-profile-light pointer-events-none absolute inset-0 z-0' />
      <span class='relative z-10 mb-2 inline-flex w-fit items-center gap-2 rounded-full border border-border/80 bg-background/75 px-3 py-1 text-xs font-medium text-muted-foreground'>
        <Icon name='github' class='size-4' /> GitHub profile
      </span>
      <h2 class='relative z-10 m-0 text-2xl font-semibold'>Cosmo-klara</h2>
      <p class='relative z-10 mb-0 mt-1 text-sm text-muted-foreground'>Researcher · Developer</p>
      <span class='absolute right-5 top-5 z-10 rounded-full border border-border/80 bg-background/75 p-2 text-muted-foreground transition-all group-hover:translate-x-0.5 group-hover:text-primary'>
        <svg aria-hidden='true' viewBox='0 0 24 24' class='size-4' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'>
          <path d='M5 12h14' /><path d='m12 5 7 7-7 7' />
        </svg>
      </span>
    </a>
  </div>

  <h2 id='sponsorship'>Sponsorship</h2>
  <p>如果你觉得我的工作有帮助，欢迎赞助支持；赞助后也欢迎留言或联系我。</p>
  <Sponsorship class='justify-start' methods={[{ name: 'WeChat', icon: 'wechat-pay', image: wechat }]} />
</PageLayout>

<script>
  import { setupSpotlights } from '@/utils/spotlight'

  setupSpotlights()
  document.addEventListener('astro:page-load', () => setupSpotlights())
</script>

<style>
  .project-profile-light {
    opacity: 0;
    background: radial-gradient(
      280px circle at var(--spotlight-x, 50%) var(--spotlight-y, 50%),
      hsl(var(--primary) / 0.22),
      transparent 72%
    );
    transition: opacity 250ms ease;
  }

  .project-profile:hover .project-profile-light,
  .project-profile:focus-visible .project-profile-light {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-profile,
    .project-profile-light {
      transition: none;
    }
  }
</style>
