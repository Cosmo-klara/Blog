---
import type { MarkdownHeading } from 'astro'

import { generateToc } from '../../plugins/toc'
import TOCHeading from './TOCHeading.astro'

interface Props {
  headings: MarkdownHeading[]
  class?: string
  id?: string
}

const { headings, class: className, ...props } = Astro.props

const toc = generateToc(headings)
---

<toc-heading class={className} {...props}>
  <h2 class='font-medium'>TABLE OF CONTENTS</h2>
  <ul class='mt-4'>
    {toc.map((heading) => <TOCHeading heading={heading} />)}
  </ul>
</toc-heading>

<script>
  // This script tag is useful only if you want to display the TOC alongside the blog post...
  // ... and highlight the section that the user is currently reading through.
  // Feel free to remove this tag if you don't need this type of functionality.

  interface TOCLink {
    element: HTMLAnchorElement
    progressBar: HTMLElement
    slug: string
  }

  interface HeadingProgress {
    inView: boolean
    progress: number
  }

  class TOC extends HTMLElement {
    headings: HTMLElement[] = []
    tocLinks: TOCLink[] = []
    headingProgress: Record<string, HeadingProgress> = {}
    animationFrame = 0
    resizeObserver?: ResizeObserver

    constructor() {
      super()
    }

    connectedCallback() {
      this.headings = Array.from(
        document.querySelectorAll(
          'article h1, article h2, article h3, article h4, article h5, article h6'
        )
      )
      this.tocLinks = Array.from(this.querySelectorAll('a[href^="#"]')).map((link) => ({
        element: link as HTMLAnchorElement,
        progressBar: link.previousElementSibling as HTMLElement,
        slug: (link.getAttribute('href') || '').substring(1)
      }))
      // Smooth scroll
      this.tocLinks.forEach((link) => {
        link.element.addEventListener('click', (e) => {
          e.preventDefault()
          // Push the history to add the hash at the end of the URL
          const directHeading = this.headings.find((heading) => heading.id === link.slug)
          if (directHeading) {
            // Push the history to add the hash at the end of the URL
            history.pushState(
              null,
              directHeading.textContent || '',
              link.element.getAttribute('href')
            )
            directHeading.scrollIntoView({ behavior: 'smooth' })
          } else {
            console.warn(`No heading found for slug: ${link.slug}`)
          }
        })
      })

      window.addEventListener('scroll', this.scheduleUpdate, { passive: true })
      window.addEventListener('resize', this.scheduleUpdate, { passive: true })
      this.resizeObserver = new ResizeObserver(this.scheduleUpdate)
      const content = document.querySelector('#content')
      if (content) this.resizeObserver.observe(content)
      this.updatePositionAndStyle()
    }

    disconnectedCallback() {
      window.removeEventListener('scroll', this.scheduleUpdate)
      window.removeEventListener('resize', this.scheduleUpdate)
      this.resizeObserver?.disconnect()
      cancelAnimationFrame(this.animationFrame)
    }

    scheduleUpdate = () => {
      if (this.animationFrame) return
      this.animationFrame = requestAnimationFrame(() => {
        this.animationFrame = 0
        this.updatePositionAndStyle()
      })
    }

    updatePositionAndStyle = () => {
      const windowHeight = window.innerHeight
      const content = document.querySelector('#content')
      const contentBottom = content?.getBoundingClientRect().bottom ?? windowHeight + 127

      this.headings.forEach((heading, index) => {
        const top = heading.getBoundingClientRect().top
        const nextTop = this.headings[index + 1]?.getBoundingClientRect().top ?? contentBottom
        const rangeEnd = Math.max(top + heading.offsetHeight, nextTop)
        const progress = Math.max(0, Math.min(1, (windowHeight - top) / (rangeEnd - top)))

        this.headingProgress[heading.id] = {
          inView: top < windowHeight && rangeEnd > 0,
          progress
        }
      })

      this.tocLinks.forEach(({ element, progressBar, slug }, index) => {
        const state = this.headingProgress[slug]
        if (!state) return

        const previous = this.headingProgress[this.tocLinks[index - 1]?.slug]
        const next = this.headingProgress[this.tocLinks[index + 1]?.slug]
        element.classList.toggle('highlight', state.inView)
        element.classList.toggle('highlight-bg-translucent', state.inView)
        element.classList.toggle('rounded-t-2xl', state.inView && (index === 0 || !previous?.inView))
        element.classList.toggle(
          'rounded-b-2xl',
          state.inView && (index === this.tocLinks.length - 1 || !next?.inView)
        )
        progressBar.classList.toggle('is-read', !state.inView && state.progress === 1)
        progressBar.classList.toggle('highlight-bg', state.inView)
        progressBar.style.setProperty('height', `${state.progress * 90}%`)
      })
    }
  }

  customElements.define('toc-heading', TOC)
</script>

<style>
  toc-heading :global(.toc-item) {
    display: flow-root;
  }
</style>
