---
import { Image } from 'astro:assets'
import { type CollectionEntry, type CollectionKey, render } from 'astro:content'

import { cn } from '../../utils'
import { Button, FormattedDate, Icon } from '../user'

type Props<T extends CollectionKey> = {
  post: CollectionEntry<T>
  detailed?: boolean
  class?: string
}

const { post, detailed = false, class: className } = Astro.props
const { id, data } = post
const { remarkPluginFrontmatter } = await render(post)
const postDate = data.updatedDate ?? data.publishDate
---

<li
  class={cn('post-preview h-full', className)}
  style={detailed &&
    data.heroImage?.color &&
    `--preview-highlight:color-mix(in srgb,${data.heroImage.color} 40%,hsl(var(--foreground)/var(--un-text-opacity,1)))`}
>
  <article
    class={cn(
      'post-preview-card flex h-full flex-col overflow-hidden rounded-2xl border bg-background transition-all duration-300',
      detailed ? 'border-border/70' : 'border-transparent'
    )}
  >
    <a
      class={cn('group block min-w-0 no-underline', detailed && 'flex flex-1 flex-col')}
      href={`/blog/${id}`}
      data-astro-prefetch
    >
      {
        detailed && (
          <div class='relative aspect-[16/8] w-full overflow-hidden bg-muted'>
            {data.heroImage ? (
              <Image
                alt={data.heroImage.alt || data.title}
                class='h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]'
                loading='lazy'
                {...data.heroImage}
              />
            ) : (
              <div
                aria-hidden='true'
                class='h-full w-full'
                style='background:linear-gradient(135deg,hsl(var(--muted)),hsl(var(--card)))'
              />
            )}
            <div
              aria-hidden='true'
              class='pointer-events-none absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-black/20 to-transparent'
            />
          </div>
        )
      }

      <div
        class={cn(
          'relative flex flex-col gap-2',
          detailed ? 'flex-1 p-4 sm:p-5' : 'gap-1 px-5 py-2.5 max-sm:px-4 sm:flex-row sm:items-center'
        )}
      >
        {detailed && (
          <div class='flex items-center justify-between gap-2 text-xs text-muted-foreground'>
            <FormattedDate date={postDate} />
            {data.draft && <span class='font-medium text-red-500'>Draft</span>}
          </div>
        )}

        <div class={cn('flex min-w-0 items-start justify-between gap-3', !detailed && 'flex-grow')}>
          {!detailed && <FormattedDate class='min-w-[95px] text-xs' date={postDate} />}
          <div class='min-w-0 flex-1'>
            {detailed ? (
              <h2 class='post-preview-title line-clamp-2 text-lg font-semibold leading-snug text-foreground transition-colors'>
                {data.draft && <span class='text-red-500'>Draft · </span>}
                {data.title}
              </h2>
            ) : (
              <div class='post-preview-title line-clamp-1 font-medium text-foreground transition-colors'>
                {data.draft && <span class='text-red-500'>(Draft) </span>}
                {data.title}
              </div>
            )}
          </div>
          <svg
            xmlns='http://www.w3.org/2000/svg'
            width='18'
            height='18'
            viewBox='0 0 24 24'
            fill='none'
            stroke-width='2'
            stroke-linecap='round'
            stroke-linejoin='round'
            class='mt-0.5 shrink-0 stroke-muted-foreground transition-all duration-300 group-hover:translate-x-0.5 group-hover:stroke-primary'
            aria-hidden='true'
          >
            <path d='M5 12h14' />
            <path d='m12 5 7 7-7 7' />
          </svg>
        </div>

        {
          detailed && (
            <>
              <p class='line-clamp-2 text-sm leading-relaxed text-muted-foreground'>
                {data.description}
              </p>
              <div class='mt-auto flex flex-wrap items-center gap-x-4 gap-y-1 pt-2 text-xs text-muted-foreground'>
                <span class='flex items-center gap-1.5'>
                  <Icon name='time' class='size-4' />
                  {remarkPluginFrontmatter.minutesRead}
                </span>
                {data.language && (
                  <span class='flex items-center gap-1.5'>
                    <Icon name='earth' class='size-4' />
                    {data.language}
                  </span>
                )}
              </div>
            </>
          )
        }
      </div>
    </a>

    {
      detailed && data.tags.length > 0 && (
        <div class='px-4 pb-4 sm:px-5'>
          <ul class='tag-list flex flex-wrap gap-2 border-t border-border/60 pt-3' aria-label='Tags'>
            {data.tags.map((tag: string) => (
              <li>
                <Button as='a' title={tag} href={`/tags/${tag}`} variant='pill' />
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </article>

  <style>
    .post-preview-card:hover {
      border-color: var(--preview-highlight, hsl(var(--border)));
      box-shadow: 0 10px 28px color-mix(in srgb, var(--preview-highlight, hsl(var(--primary))) 12%, transparent);
    }
    .post-preview-card:hover .post-preview-title {
      color: var(--preview-highlight, hsl(var(--primary)));
    }
    .tag-list a:hover {
      border-color: var(--preview-highlight, hsl(var(--border)));
      color: var(--preview-highlight, hsl(var(--primary)));
    }
  </style>
</li>
