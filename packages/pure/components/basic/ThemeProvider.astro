{/* Use inline mode to quick load color, which can avoid splash */}
<script is:inline>
  function simpleSetTheme() {
    let theme = localStorage.getItem('theme')
    if (theme !== 'dark' && theme !== 'light') {
      theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
    }
    document.documentElement.classList.toggle('dark', theme === 'dark')
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', theme === 'dark' ? '#16171D' : '#FCFCFD')
    document.querySelector('#toggleDarkMode')?.setAttribute('data-theme', theme)
  }
  simpleSetTheme()
  document.addEventListener('astro:page-load', () => simpleSetTheme())
</script>

<script>
  import { Icons } from '../../libs/icons'
  import { getSystemTheme, getTheme, listenThemeChange, setTheme } from '../../utils'

  const syncTheme = () => {
    const theme = getTheme() ?? getSystemTheme()
    setTheme(theme)
    document.querySelector('#toggleDarkMode')?.setAttribute('data-theme', theme)
  }

  listenThemeChange()
  syncTheme()
  document.addEventListener('astro:page-load', syncTheme)

  // Listen for toast event
  document.addEventListener('toast', (e) => {
    const { message, time } = (e as CustomEvent).detail
    const toast = document.createElement('div')
    toast.className =
      'animate fixed bottom-8 z-20 px-4 py-2 bg-muted text-foreground rounded-lg border shadow-lg flex items-center gap-2'
    toast.innerHTML = `<svg width='22' height='22' viewBox='0 0 24 24' fill='currentColor'>${Icons.info}</svg> <span>${message}</span>`
    document.body.appendChild(toast)
    setTimeout(() => {
      toast.remove()
    }, time || 3000)
  })
</script>
